<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="@dimen/space_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foodImage"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_food"
            app:shapeAppearance="@style/ShapeAppearance.ShareBite.Small" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/foodTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ShareBite.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusBadge"
                    style="@style/ShareBite.Badge" />

                <TextView
                    android:id="@+id/distributionBadge"
                    style="@style/ShareBite.Badge"
                    android:layout_marginStart="@dimen/space_xs" />
            </LinearLayout>

            <TextView
                android:id="@+id/stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                android:textColor="@color/charcoal" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/stockProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:indicatorColor="@color/leaf_green"
                app:trackColor="@color/cream_dark"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/deadline"
                style="@style/ShareBite.MetaRow"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                app:drawableStartCompat="@drawable/ic_schedule" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
