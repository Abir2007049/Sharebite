<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_xl" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/welcome_title"
            android:textAppearance="@style/TextAppearance.ShareBite.Display"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/welcome_subtitle"
            android:textAppearance="@style/TextAppearance.ShareBite.BodyLarge"
            android:textColor="@color/soft_green" />

        <TextView
            style="@style/ShareBite.WelcomeFeature"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/welcome_feature_free"
            app:drawableStartCompat="@drawable/ic_restaurant" />

        <TextView
            style="@style/ShareBite.WelcomeFeature"
            android:text="@string/welcome_feature_discount"
            app:drawableStartCompat="@drawable/ic_local_offer" />

        <TextView
            style="@style/ShareBite.WelcomeFeature"
            android:text="@string/welcome_feature_charity"
            app:drawableStartCompat="@drawable/ic_favorite" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_xl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:text="@string/get_started"
            android:textColor="@color/forest_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            style="@style/Widget.ShareBite.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/have_account"
            android:textColor="@color/white"
            app:strokeColor="#80FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guestButton"
            style="@style/Widget.ShareBite.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/browse_as_guest"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
