<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xxl">

        <include
            android:id="@+id/header"
            layout="@layout/view_screen_header" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="@dimen/avatar"
                        android:layout_height="@dimen/avatar"
                        android:background="@drawable/bg_icon_circle"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.ShareBite.Headline"
                        android:textColor="@color/forest_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/displayName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ShareBite.Title" />

                        <TextView
                            android:id="@+id/roleBadge"
                            style="@style/ShareBite.Badge"
                            android:layout_marginTop="@dimen/space_xs"
                            android:backgroundTint="@color/mint_container"
                            android:textColor="@color/forest_green_dark" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/email"
                    style="@style/ShareBite.MetaRow"
                    android:layout_marginTop="@dimen/space_l"
                    app:drawableStartCompat="@drawable/ic_email" />

                <TextView
                    android:id="@+id/phone"
                    style="@style/ShareBite.MetaRow"
                    android:layout_marginTop="@dimen/space_s"
                    app:drawableStartCompat="@drawable/ic_phone" />

                <TextView
                    android:id="@+id/organization"
                    style="@style/ShareBite.MetaRow"
                    android:layout_marginTop="@dimen/space_s"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_business" />

                <LinearLayout
                    android:id="@+id/verificationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/leaf_green" />

                    <TextView
                        android:id="@+id/verificationBadge"
                        style="@style/ShareBite.Badge"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menuEditProfile"
                    style="@style/ShareBite.MenuRow"
                    android:text="@string/edit_profile"
                    app:drawableStartCompat="@drawable/ic_edit" />

                <TextView
                    android:id="@+id/menuNotifications"
                    style="@style/ShareBite.MenuRow"
                    android:text="@string/notifications"
                    app:drawableStartCompat="@drawable/ic_notifications" />

                <TextView
                    android:id="@+id/menuVerification"
                    style="@style/ShareBite.MenuRow"
                    android:text="@string/charity_verification"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_shield" />

                <TextView
                    android:id="@+id/menuSafety"
                    style="@style/ShareBite.MenuRow"
                    android:text="@string/food_safety_guidelines"
                    app:drawableStartCompat="@drawable/ic_info" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.ShareBite.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/log_out"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/error_red" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ShareBite.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
