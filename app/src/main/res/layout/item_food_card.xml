<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="@dimen/space_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/food_card_image_height">

            <ImageView
                android:id="@+id/foodImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_food" />

            <TextView
                android:id="@+id/distributionBadge"
                style="@style/ShareBite.Badge"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_m" />

            <TextView
                android:id="@+id/timeLeft"
                style="@style/ShareBite.Badge"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_m"
                android:backgroundTint="@color/scrim_dark"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/foodTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.ShareBite.Title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ShareBite.Title"
                        android:textColor="@color/forest_green" />

                    <TextView
                        android:id="@+id/originalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/providerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ShareBite.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quantity"
                    style="@style/ShareBite.MetaRow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="@color/charcoal"
                    app:drawableStartCompat="@drawable/ic_restaurant" />

                <TextView
                    android:id="@+id/distance"
                    style="@style/ShareBite.MetaRow"
                    android:layout_width="wrap_content"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_place" />
            </LinearLayout>

            <TextView
                android:id="@+id/allergenWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_rounded_panel"
                android:backgroundTint="@color/warning_bg"
                android:drawablePadding="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                android:textColor="@color/warning_amber"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_warning"
                app:drawableTint="@color/warning_amber" />

            <TextView
                android:id="@+id/eligibilityNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/charity_only_note"
                android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                android:textColor="@color/charity_berry"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
