<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xxl">

        <include
            android:id="@+id/header"
            layout="@layout/view_screen_header" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:indeterminate="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:id="@+id/heroValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero"
                android:textAppearance="@style/TextAppearance.ShareBite.Display"
                android:textColor="@color/white"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/heroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ShareBite.BodyLarge"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/impact_hero_caption"
                android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                android:textColor="@color/soft_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_rounded_panel"
            android:padding="@dimen/space_l"
            android:textAppearance="@style/TextAppearance.ShareBite.Body"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/statCompleted"
                layout="@layout/view_stat_card" />

            <Space
                android:layout_width="@dimen/space_m"
                android:layout_height="1dp" />

            <include
                android:id="@+id/statPartners"
                layout="@layout/view_stat_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/statActive"
                layout="@layout/view_stat_card" />

            <Space
                android:layout_width="@dimen/space_m"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/statCharityContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <include
                    android:id="@+id/statCharity"
                    layout="@layout/view_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_activity"
                    android:textAppearance="@style/TextAppearance.ShareBite.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_activity_caption"
                    android:textAppearance="@style/TextAppearance.ShareBite.Caption" />

                <com.sharebite.app.ui.widget.BarChartView
                    android:id="@+id/monthlyChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/space_m" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/by_category"
                    android:textAppearance="@style/TextAppearance.ShareBite.Title" />

                <LinearLayout
                    android:id="@+id/categoryRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/categoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/no_data_yet"
                    android:textAppearance="@style/TextAppearance.ShareBite.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/impact_methodology"
            android:textAppearance="@style/TextAppearance.ShareBite.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
