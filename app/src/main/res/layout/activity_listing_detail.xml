<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/listing_details" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_xl">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/foodImage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/detail_image_height"
                    android:contentDescription="@string/food_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_food"
                    app:shapeAppearance="@style/ShapeAppearance.ShareBite.Medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/distributionBadge"
                        style="@style/ShareBite.Badge" />

                    <TextView
                        android:id="@+id/statusBadge"
                        style="@style/ShareBite.Badge"
                        android:layout_marginStart="@dimen/space_xs" />

                    <TextView
                        android:id="@+id/categoryBadge"
                        style="@style/ShareBite.Badge"
                        android:layout_marginStart="@dimen/space_xs"
                        android:backgroundTint="@color/cream_dark"
                        android:textColor="@color/charcoal_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.ShareBite.Headline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ShareBite.SectionTitle"
                        android:textColor="@color/forest_green" />

                    <TextView
                        android:id="@+id/originalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.ShareBite.Body"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/discount"
                        style="@style/ShareBite.Badge"
                        android:layout_marginStart="@dimen/space_s"
                        android:backgroundTint="@color/discount_amber_bg"
                        android:textColor="@color/discount_amber"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/TextAppearance.ShareBite.BodyLarge" />

                <!-- Allergen warning (prominent when allergens are declared). -->
                <LinearLayout
                    android:id="@+id/allergenBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_rounded_panel"
                    android:backgroundTint="@color/warning_bg"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/warning_amber" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/allergen_warning_title"
                            android:textAppearance="@style/TextAppearance.ShareBite.Title"
                            android:textColor="@color/warning_amber" />

                        <TextView
                            android:id="@+id/allergenText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ShareBite.Body"
                            android:textColor="@color/charcoal" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Availability and timing -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:id="@+id/availableText"
                            style="@style/ShareBite.MetaRow"
                            android:textAppearance="@style/TextAppearance.ShareBite.Title"
                            app:drawableStartCompat="@drawable/ic_restaurant" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/stockProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            app:indicatorColor="@color/leaf_green"
                            app:trackColor="@color/cream_dark"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/pickupWindow"
                            style="@style/ShareBite.MetaRow"
                            android:layout_marginTop="@dimen/space_m"
                            android:textColor="@color/charcoal"
                            app:drawableStartCompat="@drawable/ic_schedule" />

                        <TextView
                            android:id="@+id/timeLeft"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:textAppearance="@style/TextAppearance.ShareBite.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Provider -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_l">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="11dp"
                            android:src="@drawable/ic_business"
                            app:tint="@color/forest_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/providerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.ShareBite.Title" />

                            <TextView
                                android:id="@+id/providerType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.ShareBite.Caption" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/callButton"
                            style="@style/Widget.Material3.Button.IconButton.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/call_provider"
                            android:visibility="gone"
                            app:icon="@drawable/ic_phone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pickup location -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pickup_location"
                            android:textAppearance="@style/TextAppearance.ShareBite.Label" />

                        <TextView
                            android:id="@+id/address"
                            style="@style/ShareBite.MetaRow"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/charcoal"
                            app:drawableStartCompat="@drawable/ic_place" />

                        <TextView
                            android:id="@+id/distance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:textAppearance="@style/TextAppearance.ShareBite.Caption"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/directionsButton"
                            style="@style/Widget.ShareBite.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/directions"
                            app:icon="@drawable/ic_directions" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Food safety -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_food_safety"
                            android:textAppearance="@style/TextAppearance.ShareBite.Label" />

                        <TextView
                            android:id="@+id/preparedAt"
                            style="@style/ShareBite.MetaRow"
                            android:layout_marginTop="@dimen/space_s"
                            app:drawableStartCompat="@drawable/ic_restaurant" />

                        <TextView
                            android:id="@+id/storage"
                            style="@style/ShareBite.MetaRow"
                            android:layout_marginTop="@dimen/space_s"
                            app:drawableStartCompat="@drawable/ic_kitchen" />

                        <TextView
                            android:id="@+id/allergensLine"
                            style="@style/ShareBite.MetaRow"
                            android:layout_marginTop="@dimen/space_s"
                            app:drawableStartCompat="@drawable/ic_warning" />

                        <TextView
                            android:id="@+id/safetyNotes"
                            style="@style/ShareBite.MetaRow"
                            android:layout_marginTop="@dimen/space_s"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_info" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/consumer_safety_disclaimer"
                            android:textAppearance="@style/TextAppearance.ShareBite.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pickup weather (Open-Meteo) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/weatherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_cloud"
                                app:tint="@color/info_blue" />

                            <TextView
                                android:id="@+id/weatherSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.ShareBite.Title" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/weatherProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="true"
                                app:indicatorSize="20dp"
                                app:trackThickness="2dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/weatherRetry"
                                style="@style/Widget.ShareBite.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/retry"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/weatherAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/TextAppearance.ShareBite.Body"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/weather_attribution"
                            android:textAppearance="@style/TextAppearance.ShareBite.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Owner only: reservations of this listing -->
                <LinearLayout
                    android:id="@+id/ownerSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/ShareBite.SectionHeader"
                        android:layout_marginTop="@dimen/space_xl"
                        android:text="@string/reservations_for_listing" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/reservationList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="-20dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/reservationsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:background="@drawable/bg_rounded_panel"
                        android:padding="@dimen/space_l"
                        android:text="@string/no_reservations_for_listing"
                        android:textAppearance="@style/TextAppearance.ShareBite.Body" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/errorState"
            layout="@layout/view_empty_state"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom action bar -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/space_m"
        android:visibility="gone">

        <TextView
            android:id="@+id/actionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ShareBite.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondaryButton"
                style="@style/Widget.ShareBite.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
