<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/messages" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="@string/chat_empty"
            android:textAppearance="@style/TextAppearance.ShareBite.Body"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/closedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neutral_status_bg"
        android:gravity="center"
        android:padding="@dimen/space_l"
        android:text="@string/chat_closed"
        android:textAppearance="@style/TextAppearance.ShareBite.Caption"
        android:visibility="gone" />

    <!-- Floating composer. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:stateListAnimator="@null"
        app:shapeAppearance="@style/ShapeAppearance.ShareBite.Nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_xs">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/chat_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:maxLines="4"
                android:minHeight="@dimen/touch_target"
                android:textAppearance="@style/TextAppearance.ShareBite.BodyLarge"
                android:textColorHint="@color/charcoal_hint" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_send"
                android:src="@drawable/ic_send"
                app:tint="@color/forest_green" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
