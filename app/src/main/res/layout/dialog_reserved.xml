<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl">

    <FrameLayout
        android:id="@+id/reservedBadge"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/forest_green" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:text="@string/reserved_title"
        android:textAppearance="@style/TextAppearance.ShareBite.Headline" />

    <TextView
        android:id="@+id/reservedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ShareBite.Body" />
</LinearLayout>
