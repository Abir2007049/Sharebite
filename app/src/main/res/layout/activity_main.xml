<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Floating navigation pill. System-bar insets are added to its margins in MainActivity. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nav_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_m"
        android:stateListAnimator="@null"
        app:cardElevation="@dimen/nav_elevation"
        app:shapeAppearance="@style/ShapeAppearance.ShareBite.Nav">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:paddingBottomSystemWindowInsets="false" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
