<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Device status from system broadcasts (airplane mode, low battery, Battery Saver). -->
    <TextView
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nav_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_rounded_panel"
        android:backgroundTint="@color/warning_bg"
        android:drawablePadding="@dimen/space_s"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.ShareBite.Caption"
        android:textColor="@color/warning_amber"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_info"
        app:drawableTint="@color/warning_amber" />

    <!-- Floating navigation pill. System-bar insets are added to its margins in MainActivity. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nav_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_m"
        android:stateListAnimator="@null"
        app:cardElevation="@dimen/nav_elevation"
        app:shapeAppearance="@style/ShapeAppearance.ShareBite.Nav">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:paddingBottomSystemWindowInsets="false" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
