    <!-- Setup -->
    <string name="setup_title">Connect a Firebase project</string>
    <string name="setup_body">This build of ShareBite has no Firebase configuration, so it cannot sign you in or load food listings. ShareBite never fakes a backend: add your own Firebase project and rebuild.</string>
    <string name="setup_steps">1. Create a Firebase project\n2. Add an Android app with package\n   com.sharebite.app\n3. Download google-services.json into\n   ShareBite/app/\n4. Enable Email/Password sign-in,\n   Cloud Firestore and Storage\n5. Deploy firestore.rules and\n   storage.rules (see README)\n6. Rebuild and reinstall the app</string>
