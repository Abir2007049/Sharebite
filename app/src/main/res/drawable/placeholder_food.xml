<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while a food image loads, or when a listing has no photo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/image_placeholder"
                android:startColor="#F3F8F6" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item
        android:width="30dp"
        android:height="30dp"
        android:gravity="center">
        <vector
            android:width="30dp"
            android:height="30dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="@color/image_placeholder_icon"
                android:pathData="M11,9H9V2H7v7H5V2H3v7c0,2.12 1.66,3.84 3.75,3.97V22h2.5v-9.03C11.34,12.84 13,11.12 13,9V2h-2v7zM16,6v8h2.5v8H21V2c-2.76,0 -5,2.24 -5,4z" />
        </vector>
    </item>
</layer-list>
